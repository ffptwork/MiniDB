@using MiniDB.Web.Models

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead>
            <tr>
                <th scope="col">№</th>
                @foreach (var column in Table.Columns) { <th scope="col">@column.Name</th> }
                <th scope="col">Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr @key="row.Index">
                    <th scope="row">@(row.Index + 1)</th>
                    @foreach (var column in Table.Columns)
                    {
                        <td class="data-value">@row.Values.GetValueOrDefault(column.Name)</td>
                    }
                    <td><button class="btn btn-outline-primary btn-sm" disabled="@Busy" @onclick="() => OnEdit.InvokeAsync(row)">Редагувати</button></td>
                </tr>
            }
            @if (Rows.Count == 0)
            {
                <tr><td colspan="@(Table.Columns.Count + 2)" class="text-muted text-center py-4">Рядків немає.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public TableDto Table { get; set; } = null!;
    [Parameter, EditorRequired] public IReadOnlyList<RowDto> Rows { get; set; } = [];
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<RowDto> OnEdit { get; set; }
}
