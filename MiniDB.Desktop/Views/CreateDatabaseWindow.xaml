<Window x:Class="MiniDB.Desktop.Views.CreateDatabaseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Створити базу" Width="460" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="Нова база даних" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
        <TextBlock Text="Назва бази" Margin="0,0,0,6" />
        <TextBox x:Name="NameBox" />
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,12,0,0" />
        <TextBlock x:Name="BusyText" Text="" Foreground="#64748B" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Створити" IsDefault="True" Click="SaveClick" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CancelButton" Content="Скасувати" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
