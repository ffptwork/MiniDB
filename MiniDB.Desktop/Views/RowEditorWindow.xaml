<Window x:Class="MiniDB.Desktop.Views.RowEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Рядок" Width="620" Height="680" MinWidth="500" MinHeight="460" WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock x:Name="Heading" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="FieldsControl" ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,10,16">
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="{Binding Hint}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap" />
            <TextBlock x:Name="BusyText" Foreground="#64748B" />
        </StackPanel>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SaveButton" Content="Додати" Click="SaveClick" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CancelButton" Content="Скасувати" IsCancel="True" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
