<Window x:Class="MiniDB.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="MiniDB" Height="780" Width="1220" MinHeight="620" MinWidth="1000"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="MiniDB" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Бази даних, таблиці та пошук за шаблоном" Foreground="#64748B" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="8" Padding="16">
                <Grid IsEnabled="{Binding CanInteract}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="Оновити" Click="RefreshClick" Margin="0" />
                        <TextBlock Text="Бази даних" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button Content="Створити базу" Click="CreateDatabaseClick" Style="{StaticResource PrimaryButton}" />
                        <Button Content="Видалити базу" Click="DeleteDatabaseClick" IsEnabled="{Binding CanUseDatabase}" Margin="0" />
                        <Button Content="Імпорт" Click="ImportDatabaseClick" Margin="0,8,8,0" />
                        <Button Content="Експорт" Click="ExportDatabaseClick" IsEnabled="{Binding CanUseDatabase}" Margin="0,8,0,0" />
                    </WrapPanel>
                    <ListBox x:Name="DatabaseList" Grid.Row="2" ItemsSource="{Binding Databases}" DisplayMemberPath="Name"
                             SelectedItem="{Binding SelectedDatabase, Mode=OneWay}" SelectionChanged="DatabaseSelectionChanged"
                             BorderBrush="#E2E8F0" Padding="4" />
                    <TextBlock Grid.Row="3" Text="Таблиці" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,10" />
                    <WrapPanel Grid.Row="4" Margin="0,0,0,10">
                        <Button Content="Створити таблицю" Click="CreateTableClick" IsEnabled="{Binding CanUseDatabase}" />
                        <Button Content="Видалити таблицю" Click="DeleteTableClick" IsEnabled="{Binding CanUseTable}" Margin="0,8,0,0" />
                    </WrapPanel>
                    <ListBox x:Name="TableList" Grid.Row="5" ItemsSource="{Binding Tables}" DisplayMemberPath="Name"
                             SelectedItem="{Binding SelectedTable, Mode=OneWay}" SelectionChanged="TableSelectionChanged"
                             BorderBrush="#E2E8F0" Padding="4" />
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="{Binding DatabaseTitle}" Foreground="#64748B" />
                        <TextBlock Text="{Binding TableTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,8" />
                        <TextBlock Text="{Binding SchemaSummary}" TextWrapping="Wrap" Foreground="#475569" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,14">
                        <StackPanel IsEnabled="{Binding CanUseTable}">
                            <TextBlock Text="Пошук за шаблоном" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Колонка" Margin="0,0,0,4" />
                                <TextBlock Grid.Column="1" Text="Шаблон" Margin="0,0,0,4" />
                                <ComboBox x:Name="SearchColumnBox" Grid.Row="1" ItemsSource="{Binding Columns}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SearchColumn}" Margin="0,0,10,0" />
                                <TextBox x:Name="PatternBox" Grid.Row="1" Grid.Column="1" Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0" KeyDown="PatternKeyDown" />
                                <Button Grid.Row="1" Grid.Column="2" Content="Пошук" Click="SearchClick" IsEnabled="{Binding CanSearch}" Style="{StaticResource PrimaryButton}" />
                                <Button Grid.Row="1" Grid.Column="3" Content="Скинути" Click="ResetSearchClick" Margin="0" />
                            </Grid>
                            <TextBlock Text="{Binding SearchHint}" TextWrapping="Wrap" FontSize="12" Foreground="#475569" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Content="Додати рядок" Click="AddRowClick" IsEnabled="{Binding CanUseTable}" />
                        <Button Content="Редагувати рядок" Click="EditRowClick" IsEnabled="{Binding CanEditRow}" />
                    </StackPanel>
                    <DataGrid x:Name="RowsGrid" Grid.Row="3" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                              IsEnabled="{Binding CanInteract}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                              MouseDoubleClick="RowDoubleClick" />
                    <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#B91C1C" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers><DataTrigger Binding="{Binding ErrorMessage}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="#475569" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
